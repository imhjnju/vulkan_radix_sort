#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require

const uint RADIX = 256;
const uint WORKGROUP_SIZE = 256;
const uint PARTITION_DIVISION = 8;
const uint PARTITION_SIZE = PARTITION_DIVISION * WORKGROUP_SIZE;

layout(local_size_x = WORKGROUP_SIZE) in;

layout(push_constant) uniform PushConstants {
    int pass;
    uint maxElementCount;
} pc;

layout(set = 0, binding = 0, std430) readonly buffer ElementCounts {
    uint elementCounts[];
};

layout(set = 0, binding = 1, std430) buffer GlobalHistogram {
    uint globalHistogram[];
};

layout(set = 0, binding = 2, std430) buffer PartitionHistogram {
    uint partitionHistogram[];
};

layout(set = 0, binding = 3, std430) readonly buffer KeysIn {
    uint keysIn[];
};

layout(set = 0, binding = 4, std430) buffer KeysOut {
    uint keysOut[];
};

#ifdef KEY_VALUE
layout(set = 0, binding = 5, std430) readonly buffer ValuesIn {
    uint valuesIn[];
};

layout(set = 0, binding = 6, std430) buffer ValuesOut {
    uint valuesOut[];
};
#endif

shared uint localHistogram[PARTITION_SIZE];
shared uint localHistogramSum[RADIX];
shared uint subgroupSums[WORKGROUP_SIZE / 32];  // waveCount = WG_SIZE / subgroupSize (>=32)

uvec4 getExclusiveWaveMask(uint laneIndex) {
    uvec4 mask = uvec4(0);
    for (int i = 0; i < 4; ++i) {
        if (laneIndex < 32) {
            mask[i] = (1u << laneIndex) - 1u;
            laneIndex = 0;
        } else {
            mask[i] = 0xffffffffu;
            laneIndex -= 32;
        }
    }
    return mask;
}

uint getBitCount(uvec4 value) {
    uvec4 result = bitCount(value);
    return result.x + result.y + result.z + result.w;
}

void main() {
    uint elementCount = min(elementCounts[0], pc.maxElementCount);

    uint laneIndex = gl_SubgroupInvocationID;
    uint laneCount = gl_SubgroupSize;
    uint waveIndex = gl_LocalInvocationIndex / laneCount;
    uint waveCount = WORKGROUP_SIZE / laneCount;
    uint index = waveIndex * laneCount + laneIndex;

    uvec4 waveMask = getExclusiveWaveMask(laneIndex);

    uint partitionIndex = gl_WorkGroupID.x;
    uint partitionStart = partitionIndex * PARTITION_SIZE;

    // This condition is uniform across the workgroup, keeping every barrier converged.
    if (partitionStart < elementCount) {
        for (uint i = index; i < RADIX * waveCount; i += WORKGROUP_SIZE) {
            localHistogram[i] = 0;
        }
        barrier();

        uint localKeys[PARTITION_DIVISION];
        uint localRadix[PARTITION_DIVISION];
        uint localOffsets[PARTITION_DIVISION];
        uint waveHistogram[PARTITION_DIVISION];
#ifdef KEY_VALUE
        uint localValues[PARTITION_DIVISION];
#endif

        for (uint i = 0; i < PARTITION_DIVISION; ++i) {
            uint keyIndex = partitionStart + (PARTITION_DIVISION * laneCount) * waveIndex +
                            i * laneCount + laneIndex;
            uint key = keyIndex < elementCount ? keysIn[keyIndex] : 0xffffffffu;
            localKeys[i] = key;
#ifdef KEY_VALUE
            localValues[i] = keyIndex < elementCount ? valuesIn[keyIndex] : 0;
#endif

            uint radix = bitfieldExtract(key, pc.pass * 8, 8);
            localRadix[i] = radix;

            uvec4 mask = subgroupBallot(true);
            for (uint bit = 0; bit < 8; ++bit) {
                uint digit = (radix >> bit) & 1u;
                uvec4 ballot = subgroupBallot(digit == 1u);
                mask &= uvec4(digit - 1u) ^ ballot;
            }

            uint waveOffset = getBitCount(waveMask & mask);
            uint radixCount = getBitCount(mask);
            if (waveOffset == 0) {
                atomicAdd(localHistogram[waveIndex * RADIX + radix], radixCount);
                waveHistogram[i] = radixCount;
            } else {
                waveHistogram[i] = 0;
            }
            localOffsets[i] = waveOffset;
        }
        barrier();

        uint radixTotal = 0;
        for (uint wave = 0; wave < waveCount; ++wave) {
            // Guard: each thread maps to one radix (index == radix id).
            // Required when WORKGROUP_SIZE > RADIX (e.g. 512): extra threads stay idle.
            if (index < RADIX) {
                uint histogramIndex = wave * RADIX + index;
                uint count = localHistogram[histogramIndex];
                localHistogram[histogramIndex] = radixTotal;
                radixTotal += count;
            }
        }

        uint subgroupCount = subgroupAdd(radixTotal);
        uint exclSum = subgroupExclusiveAdd(radixTotal);
        if (index < RADIX) {
            localHistogramSum[index] = exclSum;  // guard: localHistogramSum has RADIX slots
        }
        if (laneIndex == 0) {
            subgroupSums[waveIndex] = subgroupCount;
        }
        barrier();

        uint subgroupPrefix = 0;
        for (uint subgroup = 0; subgroup < waveIndex; ++subgroup) {
            subgroupPrefix += subgroupSums[subgroup];
        }
        if (index < RADIX) {
            localHistogramSum[index] += subgroupPrefix;
        }
        barrier();

        for (uint i = 0; i < PARTITION_DIVISION; ++i) {
            uint radix = localRadix[i];
            localOffsets[i] += localHistogramSum[radix] +
                               localHistogram[waveIndex * RADIX + radix];
            subgroupBarrier();
            if (waveHistogram[i] > 0) {
                atomicAdd(localHistogram[waveIndex * RADIX + radix], waveHistogram[i]);
            }
            subgroupBarrier();
        }
        barrier();

        for (uint i = index; i < RADIX; i += WORKGROUP_SIZE) {
            localHistogramSum[i] = globalHistogram[RADIX * uint(pc.pass) + i] +
                                   partitionHistogram[RADIX * partitionIndex + i] -
                                   localHistogramSum[i];
        }
        barrier();

#ifdef KEY_VALUE
        for (uint i = 0; i < PARTITION_DIVISION; ++i) {
            localHistogram[localOffsets[i]] = localKeys[i];
        }
        barrier();

        for (uint i = index; i < PARTITION_SIZE; i += WORKGROUP_SIZE) {
            uint key = localHistogram[i];
            uint radix = bitfieldExtract(key, pc.pass * 8, 8);
            uint dstOffset = localHistogramSum[radix] + i;
            if (dstOffset < elementCount) {
                keysOut[dstOffset] = key;
            }
            localKeys[i / WORKGROUP_SIZE] = dstOffset;
        }

        barrier();

        for (uint i = 0; i < PARTITION_DIVISION; ++i) {
            localHistogram[localOffsets[i]] = localValues[i];
        }
        barrier();

        for (uint i = index; i < PARTITION_SIZE; i += WORKGROUP_SIZE) {
            uint value = localHistogram[i];
            uint dstOffset = localKeys[i / WORKGROUP_SIZE];
            if (dstOffset < elementCount) {
                valuesOut[dstOffset] = value;
            }
        }
#else
        for (uint i = 0; i < PARTITION_DIVISION; ++i) {
            localHistogram[localOffsets[i]] = localKeys[i];
        }
        barrier();

        for (uint i = index; i < PARTITION_SIZE; i += WORKGROUP_SIZE) {
            uint key = localHistogram[i];
            uint radix = bitfieldExtract(key, pc.pass * 8, 8);
            uint dstOffset = localHistogramSum[radix] + i;
            if (dstOffset < elementCount) {
                keysOut[dstOffset] = key;
            }
        }
#endif
    }
}
