#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require

const uint RADIX = 256;
const uint WORKGROUP_SIZE = 256;
const uint PARTITION_DIVISION = 8;
const uint PARTITION_SIZE = PARTITION_DIVISION * WORKGROUP_SIZE;

layout(local_size_x = WORKGROUP_SIZE) in;

layout(push_constant) uniform PushConstants {
    int pass;
    uint maxElementCount;
} pc;

layout(set = 0, binding = 0, std430) readonly buffer ElementCounts {
    uint elementCounts[];
};

layout(set = 0, binding = 1, std430) buffer GlobalHistogram {
    uint globalHistogram[];
};

layout(set = 0, binding = 2, std430) buffer PartitionHistogram {
    uint partitionHistogram[];
};

shared uint intermediate[WORKGROUP_SIZE];

void main() {
    uint elementCount = min(elementCounts[0], pc.maxElementCount);

    uint laneIndex = gl_SubgroupInvocationID;
    uint laneCount = gl_SubgroupSize;
    uint waveIndex = gl_LocalInvocationIndex / laneCount;
    uint waveCount = WORKGROUP_SIZE / laneCount;
    uint index = gl_LocalInvocationIndex;
    uint radix = gl_WorkGroupID.x * waveCount + waveIndex;
    uint partitionCount = elementCount / PARTITION_SIZE +
                          uint(elementCount % PARTITION_SIZE != 0);

    if (radix < RADIX) {
        uint reduction = 0;
        for (uint partitionBase = 0; partitionBase < partitionCount; partitionBase += laneCount) {
            uint partitionIndex = partitionBase + laneIndex;
            uint value = partitionIndex < partitionCount
                             ? partitionHistogram[RADIX * partitionIndex + radix]
                             : 0;
            uint excl = subgroupExclusiveAdd(value) + reduction;
            reduction += subgroupAdd(value);
            if (partitionIndex < partitionCount) {
                partitionHistogram[RADIX * partitionIndex + radix] = excl;
            }
        }
    }

    if (gl_WorkGroupID.x == 0) {
        barrier();
        // All threads participate in the subgroup scan; out-of-range threads
        // contribute 0. This keeps barriers and subgroup ops uniform across the
        // whole workgroup (required when WORKGROUP_SIZE > RADIX, e.g. 512).
        uint value = (index < RADIX) ? globalHistogram[RADIX * uint(pc.pass) + index] : 0;
        uint excl = subgroupExclusiveAdd(value);
        uint sum = subgroupAdd(value);

        if (subgroupElect()) {
            intermediate[waveIndex] = sum;
        }
        barrier();

        // Cross-subgroup prefix sum on intermediate[]. All threads participate;
        // only the first RADIX/laneCount carry real data.
        uint intermediateValue = (index < RADIX / laneCount) ? intermediate[index] : 0;
        uint intermediateExcl = subgroupExclusiveAdd(intermediateValue);
        if (index < RADIX / laneCount) {
            intermediate[index] = intermediateExcl;
        }
        barrier();

        if (index < RADIX) {
            excl += intermediate[waveIndex];
            globalHistogram[RADIX * uint(pc.pass) + index] = excl;
        }
    }
}
